<Window x:Class="FamilyTransfer.Views.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт в MySQL" 
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="750">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="Background" Value="#F9F9F9"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <!-- Стиль для кнопки-стрелки -->
        <Style x:Key="ToggleButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3498DB"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ОСНОВНАЯ ЛЕВАЯ ПАНЕЛЬ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Информация (растягивается) -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки Старт/Стоп -->
                <RowDefinition Height="Auto"/>
                <!-- Прогресс бар -->
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" Background="#2C3E50" CornerRadius="5" Margin="0,0,0,10" Padding="10">
                <TextBlock Text="{Binding DocumentTitle}" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Информация (растягивается) -->
            <GroupBox Grid.Row="1" Header="Информация" Margin="0,0,0,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" FontWeight="Bold" Margin="0,0,0,5" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="1" Text="{Binding ProgressDetail}" FontSize="11" Foreground="Gray" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="2" Text="{Binding SpeedInfo}" FontSize="11" Foreground="Blue" Margin="0,0,0,3" TextWrapping="Wrap"/>
                        <TextBlock Grid.Row="3" Text="{Binding TimeInfo}" FontSize="11" Foreground="Green" TextWrapping="Wrap"/>

                        <!-- Информация о последнем обновлении -->
                        <Border Grid.Row="4" Background="#FFF8E7" CornerRadius="3" Padding="5" Margin="0,5,0,0">
                            <TextBlock Text="{Binding LastUpdateInfo}" 
                                       FontSize="11" 
                                       Foreground="#8B6914" 
                                       TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <!-- Кнопки Старт/Стоп -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center"
                        Margin="0,5,0,5">
                <Button Content="Старт" Width="100" Height="35" Margin="0,0,10,0"
                        Command="{Binding StartCommand}"
                        IsEnabled="{Binding CanStart}"
                        Background="#27AE60" Foreground="White"
                        FontSize="13" FontWeight="Bold"/>

                <Button Content="Стоп" Width="100" Height="35"
                        Command="{Binding StopCommand}"
                        IsEnabled="{Binding CanStop}"
                        Background="#E74C3C" Foreground="White"
                        FontSize="13" FontWeight="Bold"/>
            </StackPanel>

            <!-- Прогресс бар -->
            <Grid Grid.Row="3" Margin="0,5,0,0">
                <ProgressBar Value="{Binding ProgressValue}" 
                             Maximum="{Binding ProgressMaximum}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Height="28"
                             MinHeight="28"/>
                <TextBlock Text="{Binding ProgressText}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
            </Grid>
        </Grid>

        <!-- ПРАВАЯ ПАНЕЛЬ С НАСТРОЙКАМИ -->
        <Grid Grid.Column="1" 
              x:Name="SettingsPanel"
              Margin="10,0,0,0"
              Width="0"
              Visibility="Collapsed">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="Auto"/>
                <!-- Настройки подключения -->
                <RowDefinition Height="Auto"/>
                <!-- Подгруженные связи -->
                <RowDefinition Height="Auto"/>
                <!-- Настройки экспорта -->
                <RowDefinition Height="Auto"/>
                <!-- Лог операций -->
                <RowDefinition Height="*"/>
                <!-- Выбор категорий (растягивается) -->
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Top"
                        Margin="0,10,0,5">
                <TextBlock Text="Дополнительные настройки" 
                           FontSize="14" 
                           FontWeight="Bold"
                           Foreground="#2C3E50"/>
            </StackPanel>

            <!-- Настройки подключения -->
            <GroupBox Grid.Row="1" Header="Настройки подключения" Margin="0,0,0,5">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="База данных:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,0,5,0"/>
                    <TextBox Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="5,0,0,0" Height="25"/>
                </Grid>
            </GroupBox>

            <!-- Подгруженные связи -->
            <GroupBox Grid.Row="2" Header="Подгруженные связи" Margin="0,0,0,5">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding LinksCountInfo}" 
                               FontSize="11" 
                               Foreground="Gray"
                               Margin="0,0,0,5"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="80">
                        <ListBox ItemsSource="{Binding LoadedLinks}" 
                                 BorderThickness="0"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E0E0E0" 
                                            BorderThickness="0,0,0,1" 
                                            Padding="5,3">
                                        <TextBlock Text="{Binding}" 
                                                   FontSize="11"
                                                   Foreground="#2C3E50"
                                                   Margin="5,0,0,0"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- Настройки экспорта -->
            <GroupBox Grid.Row="3" Header="Настройки экспорта" Margin="0,0,0,5">
                <Grid Margin="5">
                    <CheckBox IsChecked="{Binding IncludeLinkedModels}" 
                              Content="Экспортировать из связанных моделей"
                              FontSize="12"
                              Margin="5,5,0,5"/>
                </Grid>
            </GroupBox>

            <!-- Лог операций -->
            <GroupBox Grid.Row="4" Header="Лог операций" Margin="0,0,0,5">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Height="120">
                    <TextBox Text="{Binding LogMessages, Mode=OneWay}" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="11"
                             Background="#F5F5F5"/>
                </ScrollViewer>
            </GroupBox>

            <!-- Выбор категорий для экспорта (растягивается) -->
            <GroupBox Grid.Row="5" Header="Выбор категорий для экспорта" Margin="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Трубопроводные системы" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>

                            <CheckBox IsChecked="{Binding IncludePipeAccessory}" 
                                      Content="Pipe Accessory"/>
                            <CheckBox IsChecked="{Binding IncludePipeFitting}" 
                                      Content="Pipe Fitting"/>
                            <CheckBox IsChecked="{Binding IncludePlumbingFixtures}" 
                                      Content="Plumbing Fixtures"/>
                            <CheckBox IsChecked="{Binding IncludePipeCurves}" 
                                      Content="Pipe Curves"/>
                            <CheckBox IsChecked="{Binding IncludePipeInsulations}" 
                                      Content="Pipe Insulations"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Выбрать все" 
                                        Command="{Binding SelectAllPipesCommand}"
                                        FontSize="10" Height="25" Width="90"
                                        Background="#3498DB" Foreground="White"/>
                                <Button Content="Снять все" 
                                        Command="{Binding DeselectAllPipesCommand}"
                                        FontSize="10" Height="25" Width="90"
                                        Background="#95A5A6" Foreground="White"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Вентиляционные системы" FontWeight="Bold" Margin="0,0,0,5" FontSize="12"/>

                            <CheckBox IsChecked="{Binding IncludeDuctCurves}" 
                                      Content="Duct Curves"/>
                            <CheckBox IsChecked="{Binding IncludeMechanicalEquipment}" 
                                      Content="Mechanical Equipment"/>
                            <CheckBox IsChecked="{Binding IncludeDuctTerminal}" 
                                      Content="Duct Terminal"/>
                            <CheckBox IsChecked="{Binding IncludeDuctAccessory}" 
                                      Content="Duct Accessory"/>
                            <CheckBox IsChecked="{Binding IncludeDuctInsulations}" 
                                      Content="Duct Insulations"/>
                            <CheckBox IsChecked="{Binding IncludeDuctFitting}" 
                                      Content="Duct Fitting"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Выбрать все" 
                                        Command="{Binding SelectAllDuctsCommand}"
                                        FontSize="10" Height="25" Width="90"
                                        Background="#3498DB" Foreground="White"/>
                                <Button Content="Снять все" 
                                        Command="{Binding DeselectAllDuctsCommand}"
                                        FontSize="10" Height="25" Width="90"
                                        Background="#95A5A6" Foreground="White"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- Кнопка-стрелка для раскрытия панели -->
        <Button x:Name="ToggleButton"
                Style="{StaticResource ToggleButtonStyle}"
                Content=">"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,-1,0,0"
                Click="ToggleButton_Click"
                ToolTip="Показать/скрыть дополнительные настройки"
                Panel.ZIndex="100"/>
    </Grid>
</Window>